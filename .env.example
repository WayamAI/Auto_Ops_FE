# Base URL of the AutoOps backend API (see API_REQUIREMENTS.md for the full contract).
# Not required when VITE_DEMO_MODE=true.
VITE_API_BASE_URL=https://your-api-endpoint.com

# Demo mode runs the app fully client-side for demonstrations:
# - Auth accepts any syntactically valid email + any non-empty password.
# - Dashboards are populated from a local demo data provider instead of live API calls.
# Set to "false" (or omit) to use the real backend and OTP-based auth flow.
VITE_DEMO_MODE=true
